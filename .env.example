# Copy to .env and fill in. `make env` does the copy for you.
# docker compose overrides DATABASE_URL and REDIS_URL with container hostnames,
# so the values here are the ones you get when running the backend on the host.

# ---------------------------------------------------------------- database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orchestrator
POSTGRES_PORT=5432

# Async driver for the app. Alembic swaps it to psycopg on its own.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orchestrator

# ---------------------------------------------------------------- redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- openai
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBED_MODEL=text-embedding-3-small
# Reasoning models (o-series, gpt-5*) think before answering; "low" keeps the
# planner fast. Blank = the model's own default depth.
OPENAI_REASONING_EFFORT=low

# For an OpenAI-compatible gateway or proxy. Blank means api.openai.com.
OPENAI_BASE_URL=

# ---------------------------------------------------------------- anthropic
# console.anthropic.com -> API keys. Chat only: Anthropic has no embeddings
# endpoint at all, so EMBED_MODEL can never point here — the app refuses to
# start if it does. Leave this blank unless something below names anthropic:.
ANTHROPIC_API_KEY=

# How hard Claude thinks before answering: low | medium | high | xhigh | max.
# Anthropic's own default is high; ours is medium, because the planner call sits
# inside SOFT_DEADLINE_MS. There is no temperature on these models — it was
# removed and now returns a 400.
ANTHROPIC_EFFORT=medium

# Extended thinking. false is off, true is adaptive. Worth knowing: leaving the
# parameter out entirely means adaptive, so "off" has to be said out loud, which
# is what false does. Never budget_tokens — that knob was removed and now 400s.
ANTHROPIC_THINKING=false

# ---------------------------------------------------------------- models
# "<provider>:<name>". The prefix is the only thing that picks a provider, so
# moving the whole app to another vendor is these two lines and a restart:
#   LLM_MODEL=anthropic:claude-opus-5
#   LLM_FALLBACK_MODELS=openai:gpt-5.6-terra
# Choices: openai:gpt-5.6-terra · openai:gpt-5 · openai:gpt-5-mini
#          gemini:gemini-3.5-flash · gemini:gemini-2.5-pro
#          anthropic:claude-opus-5 · anthropic:claude-sonnet-5
#          anthropic:claude-haiku-4-5 · anthropic:claude-fable-5
# Never append a date suffix to a Claude model id; the plain name is the id.
# docs/MODELS.md has the prices and the whole comparison.
LLM_MODEL=openai:gpt-5.6-terra
# Comma separated, tried in order when the primary fails.
LLM_FALLBACK_MODELS=gemini:gemini-3.5-flash
# Optional: a different model for writing the answer than for planning it.
LLM_PROSE_MODEL=
# Which provider a model string with no prefix belongs to.
LLM_DEFAULT_PROVIDER=openai
# Per attempt, in seconds. Running past it counts as TIMEOUT.
LLM_TIMEOUT_S=20
# Failure classes worth trying another provider for. INVALID, CONTENT_FILTERED
# and AUTH_* are deliberately absent: those fail the same way everywhere.
LLM_FALLBACK_ON=RATE_LIMITED,TRANSIENT,QUOTA_EXHAUSTED,TIMEOUT

# The Gemini API key, from aistudio.google.com. Nothing to do with the OAuth
# client below — that one is for the user's Gmail, this one is for the model.
GOOGLE_AI_API_KEY=

# How the Gemini adapter talks: auto uses the google-genai SDK when it imports
# and REST over httpx when it does not. sdk and rest pin it.
GEMINI_TRANSPORT=auto

# Tokens Gemini may spend thinking before it answers. On 2.5 models thoughts and
# answer share one output budget, so anything above 0 eats into max_tokens. 0 is
# off, which gemini-2.5-pro does not allow — the adapter leaves the parameter
# out entirely for -pro.
GEMINI_THINKING_BUDGET=0

# What Gemini is told the embedding is for. Part of what makes two vectors
# comparable, exactly like the model name: change it and stored vectors stop
# matching new ones, with no error. Changing it means a full re-embed too.
GEMINI_EMBED_TASK_TYPE=SEMANTIC_SIMILARITY

# ---------------------------------------------------------------- embeddings
# Chat models are swappable. Embedding models are NOT. Every VECTOR column was
# filled by one specific model and vectors from two models are not comparable,
# so changing EMBED_MODEL means re-embedding the whole mirror:
#   python -m scripts.reembed --table all --dry-run    what it would cost
#   python -m scripts.reembed --table all --yes        batched, resumable
# It refuses a run that would leave the mirror holding two models' vectors.
# gemini:gemini-embedding-001 also does 1536 dimensions, so the column type does
# not change when you switch — but every row still has to be rebuilt.
#
# ANTHROPIC CANNOT EMBED. There is no embeddings endpoint in that API — not a
# missing adapter, not a slow path. EMBED_MODEL=anthropic:... fails at startup
# with a message saying so. Chat on Claude with embeddings on OpenAI is normal:
#   LLM_MODEL=anthropic:claude-opus-5
#   EMBED_MODEL=openai:text-embedding-3-small
EMBED_MODEL=openai:text-embedding-3-small
EMBED_DIMENSIONS=1536

# ---------------------------------------------------------------- google oauth
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client (Web).
# The redirect URI must match this string exactly, character for character.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# ---------------------------------------------------------------- secrets
# TOKEN_ENCRYPTION_KEY: 32 random bytes, urlsafe-base64. AES-256-GCM key for
# oauth_tokens.access_token_enc / refresh_token_enc.
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=replace-me-32-bytes-urlsafe-base64
# SESSION_SECRET: signs the session cookie.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-me

# ---------------------------------------------------------------- app
APP_URL=http://localhost:5173
API_PORT=8000
UI_PORT=5173
VITE_API_URL=http://localhost:8000
ENV=development
LOG_LEVEL=INFO
# false gives readable console logs while developing; true is what you want in prod.
LOG_JSON=false

# Engine tuning. app/db/session.py reads these from the environment directly.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
SQL_ECHO=false

# ---------------------------------------------------------------- budgets
RATE_LIMIT_PER_HOUR=100
SOFT_DEADLINE_MS=2500
HARD_DEADLINE_MS=12000
MAX_LLM_CALLS_PER_RUN=5

# ---------------------------------------------------------------- retrieval
# FLOOR_READ  lowest score a candidate may have and still be shown to the planner
# MARGIN      top hit must beat the runner-up by this much to be picked without asking
# FLOOR_WRITE a write may only target a candidate scoring at least this
FLOOR_READ=0.55
MARGIN=0.15
FLOOR_WRITE=0.80

# ---------------------------------------------------------------- sync
SYNC_INTERVAL_MIN=15
CELERY_CONCURRENCY=4
