    "/api/v1/auth/google": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start",
        "description": "Send the browser to Google's consent screen.\n\nOne route, two jobs, and the difference is whether anybody is signed in.\nA stranger is signing in *with* Google. Somebody already signed in is\nconnecting a workspace *to* the account they are using — so their id rides\nalong in the handshake and the connection lands there, whatever address the\nworkspace turns out to use.\n\n``next`` must be a relative path. ``//evil.example`` and\n``https://evil.example`` are the same open redirect wearing different hats,\nand :func:`google_oauth.safe_next` refuses both.",
        "operationId": "start_api_v1_auth_google_get",
        "parameters": [
          {
            "name": "next",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "/",
              "title": "Next"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Disconnect",
        "description": "Disconnect, and optionally drop the mirror.\n\nThis is a disconnect, not an account deletion. Conversations, messages,\nruns and audit rows survive — \"no hard delete\" holds everywhere except the\nmirror, which is a cache by definition and rebuilds from a resync.\n\nOrder matters. The prepared writes are cancelled and their Gmail drafts\ndeleted **first**, while the grant still works; revoking before that would\nleave half-written cancellations in the person's Drafts folder with no way\nleft to reach them.",
        "operationId": "disconnect_api_v1_auth_google_delete",
        "parameters": [
          {
            "name": "purge",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Purge"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Disconnect Api V1 Auth Google Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": []
      }
    },
