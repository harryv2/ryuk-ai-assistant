    "/api/v1/prompts/{prompt_id}/cancel": {
      "post": {
        "tags": [
          "prompts"
        ],
        "summary": "Cancel",
        "description": "Dismiss a card without answering it.\n\nCancelling a card that gates a write cancels the write and deletes the\nGmail draft it created. Cancelling a **blocking** card cancels the run — the\nsteps that already ran keep their rows, so the trace is intact. Nothing is\ndeleted; the status moves, which is what lets a reopened chat show the card\nin its cancelled state rather than a frozen snapshot.",
        "operationId": "cancel_api_v1_prompts__prompt_id__cancel_post",
        "parameters": [
          {
            "name": "prompt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Prompt Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Cancel Api V1 Prompts  Prompt Id  Cancel Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/conversations": {
      "get": {
        "tags": [
          "conversations"
        ],
        "summary": "List Conversations",
        "description": "The thread list, newest activity first.\n\nKeyset paginated on ``(last_message_at, id)`` so the partial index\n``(user_id, last_message_at DESC) WHERE archived_at IS NULL`` serves it\ndirectly. Offset paging over a list that changes while you read it shows\nduplicates and skips rows; a cursor does not.",
        "operationId": "list_conversations_api_v1_conversations_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "name": "archived",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Archived"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
