{
  "openapi": "3.1.0",
  "info": {
    "title": "Alpha Law orchestrator",
    "version": "0.1.0",
    "description": "Natural-language orchestration over Gmail, Calendar and Drive.\n\nWrites are two-phase: a query only ever *prepares* an action and the prompt that gates it. Nothing reaches Google until a person approves it through `POST /api/v1/prompts/{id}/respond`.\n\nProse documentation, including the SSE event union and the seq gap-detection contract, is in `docs/API.md`.",
    "contact": {
      "name": "Alpha Law orchestrator",
      "url": "https://example.invalid"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "paths": {
